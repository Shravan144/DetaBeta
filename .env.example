# Backend runtime configuration
# Leave DATABASE_URL unset to use a local SQLite database in your system temp directory.
# Example PostgreSQL URL: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Persistent location for uploaded CSV files during local development.
STORAGE_ROOT=backend/storage

# --- Supabase private dataset storage (backend only) ---
# Set STORAGE_BACKEND=supabase only after creating a private "datasets" bucket.
STORAGE_BACKEND=local
SUPABASE_URL=
# Use a current sb_secret_ key. Never place this in frontend variables or Git.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=datasets
MAX_UPLOAD_BYTES=26214400

# Comma-separated browser origins allowed to call the API.
# Use http://localhost:3000 for local development; never use * in production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Authentication (frontend NextAuth) ---
NEXTAUTH_SECRET=         # Random 32+ char string; generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (optional — leave blank to disable)
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo email/password login (optional — leave both blank to disable).
# When enabled, use a unique password of at least 12 characters.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_NAME=Demo User

# --- Frontend-to-backend JWT bridge ---
# Shared secret used to sign tokens between frontend and backend.
# Must be at least 32 characters. Generate with: openssl rand -base64 32
BACKEND_JWT_SECRET=
